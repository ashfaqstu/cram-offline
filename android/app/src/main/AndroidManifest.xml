<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission, and no storage permission either: documents come
         in through the system file picker, which grants access to just that one
         file. The app cannot send your documents anywhere even by accident,
         which is the strongest possible statement of "fully offline". -->

    <application
        android:allowBackup="false"
        android:label="Sift"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniTalk">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

# FIELD ORDER IS A LATENCY OPTIMIZATION (O8) - DO NOT REORDER.
# "q" is emitted FIRST so TTS can start after ~12 tokens instead of ~60.
# At ~9 tok/s, putting the slots first delays speech by roughly 5 seconds.
# Single-letter keys are deliberate: "next_question" costs ~4 tokens, "q" costs 1.
#   q = question to speak, in the target language
#   g = English gloss     s = slots learned     d = done
#
# ONE RULE PER LINE. A multi-line root rule failed to parse and llama.cpp then
# silently ran UNCONSTRAINED, producing free-form prose instead of JSON.
#
# THE {0,2} BOUND IS LOad-BEARING. With unbounded `(pair (","  pair)*)?` the 1B
# model fell into a degenerate loop and emitted
#     "s":{"ac":":",":":":",":":":", ...
# until it hit the token limit - burning the whole decode budget and filling no
# slots. An objective never has more than three slots, so cap it at three and the
# loop becomes structurally impossible rather than merely unlikely.
root ::= "{" ws "\"q\"" ws ":" ws string ws "," ws "\"g\"" ws ":" ws string ws "," ws "\"s\"" ws ":" ws slots ws "," ws "\"d\"" ws ":" ws boolean ws "}"
slots ::= "{" ws (pair (ws "," ws pair){0,2})? ws "}"
pair ::= string ws ":" ws (string | "null")
string ::= "\"" ([^"\\] | "\\" ["\\bfnrt/]){0,60} "\""
boolean ::= "true" | "false"
ws ::= [ \t\n]{0,4}
